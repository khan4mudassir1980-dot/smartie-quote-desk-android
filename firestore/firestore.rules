rules_version = '2';

// SMARTIE Quote Desk — Firestore rules v9 (DRAFT, staging only).
//
// Not deployed by this branch. Deploy to the staging project only, after the
// emulator suite in `tests/` passes. Production keeps the V8C4 rules until
// the cutover described in section 10 of the parity audit.
//
// What changes from V8C4:
//   1. The Primary Owner is identified by teamSettings/access.primaryOwnerUid.
//      The hard-coded email stays as a fallback only while that field is
//      empty, and primaryOwnerUid can never be changed once it is set.
//   2. An Administrator manages every account below an Owner (V8C4 allowed
//      the two lower roles only).
//   3. Purchase requirements are soft-deleted; a hard delete is refused for
//      everyone, so a PWA device can never resurrect a deleted item.
//   4. Purchase updates carry an optimistic `rev` counter.
//   5. Purchase ownership: the person who raised a requirement may correct
//      it while nothing has been delivered against it, and a delivery closes
//      the record to everyone but an Administrator.
//   6. Reads stay V8C4-compatible so the PWA keeps working during the
//      transition.
//   7. A finalised quotation may be EDITED (N5.10) — new behaviour; V8C4
//      cannot — within a fixed list of keys, stamped and revisioned; and its
//      creator may cancel it as well as an Owner or Administrator.
//
// A note on vocabulary, because the stored values are not the words anybody
// reads: role `staff` is displayed **Manager** and role `worker` is
// displayed **Staff**. The stored values are the PWA's and are never
// renamed; see docs/N4.2-plan.md.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- identity ------------------------------------------------------

    function signedIn()   { return request.auth != null; }
    function mine()       { return request.auth.uid; }
    function profile()    { return get(/databases/$(database)/documents/users/$(mine())).data; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(mine())); }
    function member()     { return hasProfile() && profile().active == true; }

    // The owner email the PWA hard-codes. Used only until the migration has
    // written primaryOwnerUid, and never as a way to grant a second owner.
    function ownerEmailFallback() { return 'khan4mudassir1980@gmail.com'; }

    function accessExists() {
      return exists(/databases/$(database)/documents/teamSettings/access);
    }
    function accessData() {
      return get(/databases/$(database)/documents/teamSettings/access).data;
    }
    function primaryUid() {
      return accessExists() && accessData().keys().hasAny(['primaryOwnerUid'])
        ? accessData().primaryOwnerUid
        : '';
    }

    function callerEmail() {
      return signedIn() ? request.auth.token.get('email', '') : '';
    }

    function isPrimaryOwner() {
      return signedIn() && (
        primaryUid() != ''
          ? mine() == primaryUid()
          : callerEmail() == ownerEmailFallback()
      );
    }

    /** True when the document at [uid] belongs to the protected Primary Owner. */
    function protectsPrimary(uid, data) {
      return primaryUid() != ''
        ? uid == primaryUid()
        : data.get('email', '') == ownerEmailFallback();
    }

    function owner()      { return member() && (isPrimaryOwner() || profile().role == 'owner'); }
    function admin()      { return member() && (isPrimaryOwner() || profile().role in ['owner','admin']); }
    function staff()      { return member() && profile().role == 'staff'; }
    function worker()     { return member() && profile().role == 'worker' && !isPrimaryOwner(); }
    function stockWriter(){ return admin() || staff(); }

    // A /stock document is readable by a Worker, who may never read /products.
    // The native app denormalises the descriptive `name` onto it so a Worker
    // sees more than a model code; no price or tax may travel the same way.
    function noPriceData() {
      return !request.resource.data.keys().hasAny(['dealer','contractor','client','gst']);
    }
    function safeName() { return request.resource.data.get('name', '') is string; }
    function touched()    { return request.resource.data.diff(resource.data).affectedKeys(); }
    function priceOk(v)   { return v == null || (v is number && v >= 0); }

    // --- the Manager's discount cap, enforced here for the first time ------
    //
    // **The Owner's decision has always read "a Manager is capped by a limit
    // the Owner sets, ENFORCED IN THE RULES" (docs/N5-plan.md:89). Until N5.9a
    // it was not.** `/teamSettings/quoting` bounded `managerDiscountPct` when
    // the Owner wrote it, and nothing bounded what a quotation could claim, so
    // the cap was a client-side guard a Manager writing straight to Firestore
    // never met. N5.9a commit 1 pinned that as two passing tests before this
    // commit turned them round.

    /** The Owner's limit. Only ever called when a discount is actually taken. */
    function discountCap() {
      return get(/databases/$(database)/documents/teamSettings/quoting)
               .data.get('managerDiscountPct', 0);
    }

    /**
     * Whether the discount on this quotation is one this person may give.
     *
     * **The base is bounded as well as the amount, because a cap checked
     * against a base the writer chooses is not a cap.** `QuoteMath` keeps
     * `subtotal == discBase - disc.amt + transport` in exact whole rupees, and
     * transport can never be negative, so `discBase <= subtotal + disc.amt`
     * holds for every honest quotation. It needs only stored fields, which
     * matters: transport is a *line* inside the subtotal, so no rule can see
     * it on its own.
     *
     * **That bound is exact only when transport is zero, and the slack is a
     * known figure, not a rounding.** A writer can claim a `discBase` as high
     * as the true base plus the transport and still satisfy it, which buys
     * `transport × cap ÷ 100` of discount past the cap: at a 10% cap on
     * ₹1,00,000 of products with ₹50,000 of transport, ₹15,000 instead of
     * ₹10,000. Every figure the customer sees stays honest; only `discBase`
     * is inflated. Recorded as a known bound in `docs/PROJECT-STATUS.md`.
     *
     * **The cap check is one rupee generous, never strict.** The app allows
     * `base × cap ÷ 100` rounded HALF_UP to whole rupees; this rule sees the
     * unrounded figure. Without the margin, 5% of 44,410 — ₹2,220.50, which
     * the app lets a Manager have as ₹2,221 — was refused here, and a refusal
     * at finalise is one the person cannot see coming. With it the rule
     * accepts at most one rupee the app would not, and never refuses one it
     * would. The five vectors pinning both sides are in `quotation.test.js`
     * and `QuoteDiscountTest.kt`.
     *
     * An absent `/teamSettings/quoting` refuses a Manager's discount rather
     * than allowing any — an unseeded project is not an uncapped one.
     */
    function discountOk() {
      return discountShapeOk()
        && (discountAmount() == 0 || admin() || discountWithinCap());
    }

    // **Split in N5.10 so an edit can take the shape without the cap**, and
    // `discountOk()` keeps its meaning exactly: every N5.9a cap test passes
    // unchanged against it. Short-circuits as it always did — an amount of
    // zero is accepted before `subtotal` is type-checked, which is what lets
    // V8C4's `q_string_totals` shape through.

    /** `disc.amt` as the write leaves it; zero when there is no discount. */
    function discountAmount() {
      return request.resource.data.get('disc', {}).get('amt', 0);
    }

    /** Everything about a discount except the cap: its type and its bounds. */
    function discountShapeOk() {
      let amount = discountAmount();
      let base = request.resource.data.get('discBase', 0);
      let subtotal = request.resource.data.get('subtotal', 0);
      return amount is number && amount == 0 || (
        amount is number && amount > 0
        && base is number && base >= 0
        && subtotal is number
        && base <= subtotal + amount
        && amount <= base
      );
    }

    /** The Owner's limit, one rupee generous — only ever for a real discount. */
    function discountWithinCap() {
      return exists(/databases/$(database)/documents/teamSettings/quoting)
        && discountAmount()
           <= request.resource.data.get('discBase', 0) * discountCap() / 100 + 1;
    }

    // The issuer marker on the counter's `lastIssued`: which app took the
    // number. It exists so a number that somehow goes out twice during
    // cutover can be traced to an app rather than argued about.
    //
    // **Read, never required.** V8C4's `fbFinaliseAtomic` writes `lastIssued`
    // with no `src` at all, and a missing key reads as `''` — a string of
    // size 0 — so the PWA keeps issuing numbers exactly as it does today.
    // Making it mandatory would stop the live business the day this deploys.
    function numberingSrcOk() {
      let src = request.resource.data.get('lastIssued', {}).get('src', '');
      return src is string && src.size() <= 16;
    }

    // --- people --------------------------------------------------------

    match /users/{uid} {
      allow read: if (signedIn() && mine() == uid) || admin();

      // A first sign-in creates only the caller's own profile: the business
      // owner as Owner, everybody else as an active Worker.
      allow create: if signedIn() && uid == mine()
                    && request.resource.data.keys().hasAll(['name','email','role','active'])
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.active == true
                    && ((isPrimaryOwner() && request.resource.data.role == 'owner')
                        || (!isPrimaryOwner() && request.resource.data.role == 'worker'));

      allow update: if
        // The Primary Owner manages everyone but themselves, and is the only
        // person who can appoint, demote or revoke the Additional Owner.
        (isPrimaryOwner() && member() && uid != mine()
          && !protectsPrimary(uid, resource.data)
          && request.resource.data.email == resource.data.email
          && (
            (resource.data.role != 'owner' && request.resource.data.role != 'owner')
            // Appointing writes the access slot in the same transaction.
            || (resource.data.role != 'owner' && request.resource.data.role == 'owner'
                && getAfter(/databases/$(database)/documents/teamSettings/access).data.secondOwnerUid == uid)
            // Demotion and emergency revoke clear the slot in the same write.
            || (resource.data.role == 'owner' && request.resource.data.role != 'owner'
                && getAfter(/databases/$(database)/documents/teamSettings/access).data.secondOwnerUid != uid)
          ))
        ||
        // The Additional Owner has full control, but never over either Owner
        // and never over their own account.
        (owner() && !isPrimaryOwner()
          && uid != mine()
          && resource.data.role != 'owner'
          && !protectsPrimary(uid, resource.data)
          && request.resource.data.role in ['admin','staff','worker']
          && request.resource.data.email == resource.data.email)
        ||
        // An Administrator manages Manager and Staff accounts only — never
        // another Administrator, and never an Owner. Two Administrators who
        // can each demote the other is not a hierarchy; appointing and
        // removing at that level is the Owner's. The stored values are
        // `staff` (displayed Manager) and `worker` (displayed Staff).
        (admin() && !owner()
          && uid != mine()
          && resource.data.role in ['staff','worker']
          && request.resource.data.role in ['staff','worker']
          && !protectsPrimary(uid, resource.data)
          && request.resource.data.email == resource.data.email);

      // The same list, for the same reason: an Administrator cannot delete a
      // peer they cannot demote.
      allow delete: if uid != mine()
                    && !protectsPrimary(uid, resource.data)
                    && resource.data.role != 'owner'
                    && (owner() || (admin() && !owner() && resource.data.role in ['staff','worker']));
    }

    // --- catalogue -----------------------------------------------------

    match /products/{id} {
      allow read: if member() && !worker();
      allow create, update: if admin()
                    && request.resource.data.model is string
                    && request.resource.data.model.size() > 0
                    && request.resource.data.group is string
                    && request.resource.data.group.size() > 0
                    && request.resource.data.seedModel is string
                    && request.resource.data.name is string
                    && request.resource.data.gst is number
                    && request.resource.data.gst >= 0
                    && request.resource.data.gst <= 28
                    && priceOk(request.resource.data.dealer)
                    && priceOk(request.resource.data.contractor)
                    && priceOk(request.resource.data.client)
                    && request.resource.data.active is bool;
      allow delete: if admin();
    }

    // --- stock ---------------------------------------------------------

    match /stock/{key} {
      function photoDoc() {
        return /databases/$(database)/documents/stockPhotos/$(key);
      }

      // The photo lives in its own document; these two fields are the only
      // trace of it here. They must agree with that document **in the same
      // commit**, so neither can be written without the other.
      function photoMetaOk() {
        return request.resource.data.get('hasPhoto', false) == false
          ? !existsAfter(photoDoc())
          : (existsAfter(photoDoc())
             && getAfter(photoDoc()).data.rev == request.resource.data.get('photoRev', 0));
      }

      // Monotonic, so a device that has been offline can tell a stale cached
      // image from a current one without consulting a clock.
      function photoRevMonotonic() {
        return request.resource.data.get('photoRev', 0)
          >= (resource == null ? 0 : resource.data.get('photoRev', 0));
      }

      // Workers read stock without ever being able to read /products. The
      // V8C4 document carries no descriptive name, so the native app writes
      // one additively — see noPriceData() above for the line that keeps a
      // price from following it into a Worker-readable collection.
      /**
       * Who may write a stock row: an Owner or Administrator with any
       * action, or the displayed Manager with the ones below. Setting an
       * exact quantity stays with Owner and Administrator; Staff use the
       * +/- actions, the reorder level (`min`), the note-only save (`note`)
       * and a photo change (`photo`).
       *
       * **`admin()` is asked once, by the caller** (N5.10b, the 1,000-
       * expression limit). The rules used to say `stockWriter() && … &&
       * (admin() || lastAction in …)`, asking it twice; that is
       * `(A || S) && (A || L)`, which is `A || (S && L)` — this. A stock
       * movement is two documents in one transaction, and if production
       * counts the limit per request the two used to sum to 945.
       */
      function stockRowRoleOk(isAdmin) {
        return isAdmin
          || (staff() && request.resource.data.lastAction in ['in','out','min','add','pin','note','photo']);
      }

      allow read: if member();
      // The checks on the request first, the documents after them, the role
      // last: only the role needs the caller's profile.
      allow create: if request.resource.data.q is number && request.resource.data.q >= 0
                    && request.resource.data.min is number && request.resource.data.min >= 0
                    && request.resource.data.t is number
                    && request.resource.data.byUid == mine()
                    && noPriceData() && safeName()
                    && photoRevMonotonic() && photoMetaOk()
                    && stockRowRoleOk(admin());
      allow update: if request.resource.data.q is number && request.resource.data.q >= 0
                    && request.resource.data.min is number && request.resource.data.min >= 0
                    && request.resource.data.t is number
                    && request.resource.data.byUid == mine()
                    && request.resource.data.key == resource.data.key
                    && noPriceData() && safeName()
                    && photoRevMonotonic() && photoMetaOk()
                    && stockRowRoleOk(admin());
      // A row may not be deleted out from under its photo: the photo document
      // has to go in the same commit.
      allow delete: if admin() && !existsAfter(photoDoc());
    }

    // --- stock photos ---------------------------------------------------
    //
    // One optional photo per tracked item, in its own document so that the
    // board — which reads every /stock document — never downloads image bytes
    // it did not ask for. The mobile SDKs have no `select()` projection, so a
    // photo on /stock could not have been opted out of.
    //
    // The document id is the /stock document id, which is derived from the
    // immutable stock key, so a display rename can never orphan a photo.
    match /stockPhotos/{stockDoc} {
      function stockPath() {
        return /databases/$(database)/documents/stock/$(stockDoc);
      }
      function stockAfter() { return getAfter(stockPath()).data; }

      // Every active member may see a photo, Workers included. They may read
      // /stock already; bytes carry no price, and noPriceData() keeps it so.
      allow read: if member();

      allow create, update: if stockWriter()
                    && request.resource.data.bytes is bytes
                    && request.resource.data.bytes.size() <= 81920
                    && request.resource.data.key is string
                    && request.resource.data.rev is number
                    && request.resource.data.byUid == mine()
                    && noPriceData()
                    // The stock row must claim this exact revision, in the
                    // same commit. A photo document cannot appear alone.
                    && stockAfter().hasPhoto == true
                    && stockAfter().photoRev == request.resource.data.rev;

      // Removing a photo, and the cascade when an Administrator deletes the
      // whole row: the stock document is gone after that commit, so there is
      // no `hasPhoto` left to read.
      allow delete: if stockWriter()
                    && (!existsAfter(stockPath()) || stockAfter().hasPhoto == false);
    }

    match /stockMoves/{id} {
      /**
       * Who may log a movement: an Owner or Administrator with any action,
       * or the displayed Manager with the four below — the same shape as
       * `stockRowRoleOk`, and for the same reason, `admin()` asked once.
       */
      function stockMoveRoleOk(isAdmin) {
        return isAdmin
          || (staff() && request.resource.data.action in ['in','out','min','add']);
      }

      allow read: if member() && !worker();
      allow create: if request.resource.data.id == id
                    && request.resource.data.key is string
                    // `note` is deliberately absent: a note-only save changes
                    // shared text, not a count, and logs nothing.
                    && request.resource.data.action in ['in','out','set','min','add','archive']
                    && request.resource.data.prev is number
                    && request.resource.data.next is number
                    && request.resource.data.next >= 0
                    && request.resource.data.at is number
                    && request.resource.data.byUid == mine()
                    && stockMoveRoleOk(admin());
      allow update, delete: if false;
    }

    // --- stopped-item history ------------------------------------------
    //
    // What survives when an item is removed from stock. Deliberately a
    // **separate, immutable** collection rather than a flag on /stock: the
    // old `off: true` flag left the row alive, invisible to the board and
    // still blocking a re-add with "already exists", with no way back.
    //
    // One document per removal event, with its own id, so repeated
    // add-then-remove cycles for the same key stay distinct.
    match /stoppedStock/{id} {
      function stockPath() {
        return /databases/$(database)/documents/stock/$(request.resource.data.stockDoc);
      }

      // Everyone who may see stock may see what was removed from it.
      allow read: if member();

      // Written **only** as part of removing the row, by the role that was
      // always allowed to stop tracking an item: Owner and Administrator.
      // `!existsAfter(stockPath())` is the cross-document half — history for
      // an item that is still on the board cannot be fabricated.
      allow create: if admin()
                    && request.resource.data.id == id
                    && request.resource.data.key is string
                    && request.resource.data.stockDoc is string
                    && request.resource.data.q is number
                    && request.resource.data.manual is bool
                    && request.resource.data.at is number
                    && request.resource.data.byUid == mine()
                    && noPriceData() && safeName()
                    // The quantity, the note and the photo are gone for good:
                    // none of them may be smuggled into the record that
                    // outlives them.
                    && !request.resource.data.keys().hasAny(
                         ['note','stockNote','bytes','hasPhoto','photoRev','min','pinned'])
                    && !existsAfter(stockPath());

      // Immutable. History that can be edited is not history.
      allow update: if false;

      // Clearing it is an Owner and Administrator action, the same pair that
      // may remove an item in the first place.
      allow delete: if admin();
    }

    // --- purchase ------------------------------------------------------

    function revOk() {
      return !request.resource.data.keys().hasAny(['rev'])
        || request.resource.data.rev == resource.data.get('rev', 0) + 1;
    }

    // --- purchase: who owns a requirement, and for how long ----------------
    //
    // Two rules live here and neither can be expressed by hiding a button.
    //
    // 1. The person who RAISED a requirement may correct it — name, note,
    //    quantity, urgency — or take it off the list, for as long as nothing
    //    has been delivered against it. Ownership is byUid and nothing else;
    //    a row without one belongs to nobody, which is most of what the PWA
    //    wrote.
    // 2. A delivery CLOSES the record. After it, the limited role is
    //    read-only for that requirement, `staff` may still receive what is
    //    outstanding or write off a shortfall, and a correction is an
    //    Administrator's.
    //
    // Titles, because they are not the stored values: `staff` is displayed
    // **Manager** and `worker` is displayed **Staff**. Nothing here renames
    // either. See docs/N4.2-plan.md.

    /** Ownership. A blank stored byUid never matches a signed-in uid. */
    function prCreator() {
      return resource.data.get('byUid', '') != '' && resource.data.byUid == mine();
    }

    /**
     * Nothing has been delivered against this requirement.
     *
     * Read from `resource.data`, the STORED document, so a client cannot
     * clear the receipt in the same write it edits with — and could not
     * anyway, because a removed key lands in `touched()` and no list below
     * admits one. The four rcv fields are checked by PRESENCE: the app
     * writes them together and a reopen removes them together, so any one of
     * them means a delivery was recorded, whatever the number says.
     */
    function prOpen() {
      return resource.data.get('received', false) != true
        && resource.data.get('del', false) != true
        && resource.data.get('status', 'Needed') == 'Needed';
    }

    function prUntouched() {
      return prOpen()
        && !resource.data.keys().hasAny(['rcvQty','rcvBy','rcvUid','rcvAt']);
    }

    /**
     * Who raised it, and when, are not editable by anybody — the
     * Administrator branch included. An immutable field should not depend on
     * which branch happened to match. A legacy row carrying none of these
     * still passes, because '' == ''.
     */
    function prIdentityPinned() {
      return request.resource.data.get('byUid', '') == resource.data.get('byUid', '')
        && request.resource.data.get('by', '') == resource.data.get('by', '')
        && request.resource.data.get('t', 0) == resource.data.get('t', 0);
    }

    /**
     * Correcting a requirement: what it is, how many, how urgently, and why.
     *
     * Every key-list helper takes the diff as `changed` rather than calling
     * `touched()` itself — see "the diff once" above `prPermitted`.
     */
    function prEditKeys(changed) {
      return changed.hasOnly([
        'id','name','note','qty','urgency','updated','rev','upBy','upUid','serverAt'
      ]);
    }

    /** Taking it off the list. `qty` is absent on purpose: a removal is not an edit. */
    function prRemoveKeys(changed) {
      return changed.hasOnly([
        'id','del','deletedBy','delBy','delAt','updated','rev','upBy','upUid','serverAt'
      ]) && prRemovalStamp(changed);
    }

    /** Recording a delivery. */
    function prReceiptKeys(changed) {
      return changed.hasOnly([
        'id','status','received','rcvQty','rcvBy','rcvUid','rcvAt',
        'qty','updated','rev','upBy','upUid','serverAt'
      ]);
    }

    /**
     * Writing off what is not coming: `qty` drops to what arrived and the
     * requirement closes. **No rcv key at all**, so the receipt cannot be
     * rewritten by the person writing off the remainder.
     */
    function prShortfallKeys(changed) {
      return changed.hasOnly([
        'id','status','received','qty','updated','rev','upBy','upUid','serverAt'
      ]);
    }

    /**
     * A stored receipt total this rule is willing to reason about.
     *
     * The PWA has written strings into this collection — `pr_received_legacy`
     * holds `"qty": "10"` — and comparing a string to a number here raises an
     * error rather than coercing. So a non-numeric stored total fails closed
     * for `staff`, and an Administrator rescues the row through the
     * privileged branch, exactly as they rescue a string `qty`.
     */
    function prRcvNumeric() {
      return !resource.data.keys().hasAny(['rcvQty']) || resource.data.rcvQty is number;
    }

    /** A received total may only grow. This is also what refuses a `staff` reopen. */
    function prRcvNotReduced() {
      return request.resource.data.get('rcvQty', 0) is number
        && request.resource.data.rcvQty >= resource.data.get('rcvQty', 0);
    }

    /**
     * A delivery does not change what was asked for.
     *
     * `qty` is in the receipt list only because every update re-asserts it —
     * the app writes the value it read — so it is normally not *changed* at
     * all. The one exception is the legacy rescue: a row whose stored `qty`
     * is a string is unupdatable until something writes a number, and that
     * has to stay possible. A numeric total may only be changed by an edit
     * or by writing off a shortfall, each of which has its own branch.
     */
    function prQtyKept() {
      return !(resource.data.get('qty', '') is number)
        || request.resource.data.qty == resource.data.qty;
    }

    /**
     * A delivery may only close a requirement it has actually completed.
     *
     * Without this, marking `received: true` beside a receipt that falls
     * short of the total would close a requirement at a figure nobody
     * delivered. Writing off that difference is a different thing, with its
     * own branch and its own confirmation.
     */
    function prClosesOnlyWhenMet() {
      return request.resource.data.get('received', false) != true
        || (request.resource.data.get('rcvQty', 0) is number
            && request.resource.data.rcvQty >= request.resource.data.qty);
    }

    /**
     * The shortfall, and the only quantity it may write.
     *
     * `qty` must land on exactly the stored receipt: not a figure the caller
     * chose, and not a rounding of one. The row has to be genuinely part way
     * there — something arrived, and less than was asked for — so this can
     * neither cancel an untouched requirement nor re-close a finished one.
     */
    function prShortfall() {
      return prRcvNumeric()
        && resource.data.get('rcvQty', 0) is number
        && resource.data.rcvQty > 0
        && resource.data.rcvQty < resource.data.qty
        && resource.data.get('received', false) != true
        && resource.data.get('del', false) != true
        && resource.data.get('status', 'Needed') == 'Needed'
        && request.resource.data.qty == resource.data.rcvQty
        && request.resource.data.received == true
        && request.resource.data.status == 'Received';
    }

    /**
     * Recording what arrived, or writing off what will not.
     *
     * One definition, shared by the displayed Manager and by the person who
     * raised the requirement, so the two cannot drift apart. It deliberately
     * does **not** ask whether the row is untouched: the post-receipt lock
     * takes away corrections and leaves the delivery alone, because somebody
     * should be able to finish the requirement they raised.
     */
    function prDelivery(changed) {
      return (prReceiptKeys(changed) && prOpen() && prRcvNumeric()
              && prRcvNotReduced() && prQtyKept() && prClosesOnlyWhenMet())
        || (prShortfallKeys(changed) && prShortfall());
    }

    /**
     * What a soft delete may record about itself.
     *
     * `deletedBy` was permitted without any constraint on its value, so any
     * permitted remover could write anybody's uid there; it is pinned to the
     * caller now. `delBy` and `delAt` are new, and bounded rather than merely
     * allowed.
     *
     * **No comparison against `request.time`**, deliberately. A removal made
     * offline carries the device's clock and syncs later; a server-time bound
     * would refuse a requirement withdrawn in a basement.
     */
    function prRemovalStamp(changed) {
      return (!changed.hasAny(['delBy'])
              || (request.resource.data.delBy is string
                  && request.resource.data.delBy.size() <= 80))
        && (!changed.hasAny(['delAt']) || request.resource.data.delAt is number)
        && (!changed.hasAny(['deletedBy']) || request.resource.data.deletedBy == mine());
    }

    /**
     * Who may make this update, once the common checks have passed.
     *
     * **Restructured in N5.10b for the rules engine's 1,000-expression limit,
     * with the same decision for every write.** The rule used to ask
     * `admin()`, then the Manager branch, then the creator branch, each in
     * full: `prUntouched()`, `prEditKeys()` and `prDelivery()` twice over, and
     * the document diff up to nine times. A refused write evaluates every
     * branch, so 58 refusal tests reached the limit and were denied **by the
     * engine giving up, not by their own clause** — green for the wrong
     * reason. Now:
     *
     * - **the diff once** — `touched()` is taken by the caller and passed in
     *   as `changed`;
     * - **the role once** — `admin()` is asked by the caller and passed in,
     *   as `qnEditPermitted` does;
     * - **the two ordinary branches as one** — see `prRaiserOrManager`.
     */
    function prPermitted(changed, isAdmin) {
      return prReceivedIsBoolean(changed)
        && prStatusMoves(isAdmin)
        && prClosesMet(changed)
        && prStampsAreCaller(changed)
        && (isAdmin || prRaiserOrManager(changed, prCreator()));
    }

    /**
     * A uid a write sets on a requirement is **the caller's** — `upUid`,
     * `rcvUid` and `cancelledUid` — for everyone, an Owner or Administrator
     * included. The Owner's decision of 2026-09-29 (Q1b): if it changes, it
     * must be the caller. Found in N5.10b step 1: a Manager could name the
     * Administrator as the person who received a delivery, and the app shows
     * the name it resolves from that uid.
     *
     * Only a uid the write **sets to a value** is asked about. Removing one
     * stays allowed (QG) — the Administrator's reopen deletes `rcvUid` — and
     * one carried unchanged is not in the diff, which is what V8C4 did after
     * its first write. `deletedBy` already had the same pin, in
     * `prRemovalStamp`. N5.10b commit 7 adds the Ordered uid.
     */
    function prStampsAreCaller(changed) {
      return prSetUidIsCaller(changed, 'upUid')
        && prSetUidIsCaller(changed, 'rcvUid')
        && prSetUidIsCaller(changed, 'cancelledUid');
    }

    function prSetUidIsCaller(changed, field) {
      return !changed.hasAny([field]) || prNewUidIsCaller(field);
    }

    /** Absent, or the caller: what a create or an update may leave in `field`. */
    function prNewUidIsCaller(field) {
      return !request.resource.data.keys().hasAny([field])
        || request.resource.data.get(field, '') == mine();
    }

    /**
     * `received`, whenever a write sets it, is a **boolean** — for everyone,
     * an Owner or Administrator included. The Owner's decision of 2026-09-29
     * (QA).
     *
     * V8C4 writes `received` as the number 1 (and 0). A 1 is not `true`, so
     * `prClosesOnlyWhenMet` never saw it, and V8C4's all-or-nothing receipt
     * could close a requirement short with no write-off — as could anybody
     * else who wrote a 1. Refusing the number closes that for every writer.
     * A stored number is left alone, and the readers still tolerate one; only
     * a write that sets the field must send a boolean.
     */
    function prReceivedIsBoolean(changed) {
      return !changed.hasAny(['received']) || request.resource.data.received is bool;
    }

    /**
     * How `status` may move — **only** by one of these, and a write that does
     * none of them leaves it where it was. The Owner's rule of 2026-09-29
     * (QB, variant B adapted), for everyone:
     *
     * - **closing to Received** — `received: true` with the total met, or
     *   written off first (`prClosesMet`), from an open requirement;
     * - **cancel** — from an open requirement, by an Owner or Administrator
     *   (the privileged branch is the only cancel the native app has ever
     *   had; a Manager's is N5.10b commit 7's, held for the Owner);
     * - **reopen** — back to Needed from Received or Cancelled, by an Owner or
     *   Administrator, and not while `received` stays true.
     *
     * So a delivery that does not close leaves the status alone, and nobody —
     * an Administrator included — may invent one. Before this, a delivery
     * could write any status: a Manager recording 4 of 10 could store
     * "Received" or "Cancelled" beside `received: false`, and the app counts
     * either as closed. Found in N5.10b step 1.
     *
     * N5.10b commit 7 adds Needed ↔ Ordered, by Owner and Administrator.
     */
    function prStatusMoves(isAdmin) {
      let before = resource.data.get('status', 'Needed');
      let after = request.resource.data.get('status', 'Needed');
      let receivedAfter = request.resource.data.get('received', false);
      return after == before
        || (before == 'Needed' && after == 'Received' && receivedAfter == true)
        || (isAdmin && before == 'Needed' && after == 'Cancelled' && receivedAfter != true)
        || (isAdmin && before in ['Received', 'Cancelled'] && after == 'Needed' && receivedAfter != true);
    }

    /**
     * Whatever closes a requirement meets its total — **closing short needs
     * the write-off**, for everyone. A write closes it when it sets `received`
     * to true or moves `status` to Received; then the receipt must be a
     * number at least the total. The write-off meets it by setting the total
     * to the receipt, which is what `prShortfall` insists on.
     *
     * `prClosesOnlyWhenMet` says the same for a Manager's or a creator's
     * delivery; this says it for an Owner or Administrator too, and for a
     * status move. An Administrator may still correct a closed requirement —
     * a write that leaves `received` and `status` alone is not a close.
     */
    function prClosesMet(changed) {
      let closes = (changed.hasAny(['received']) && request.resource.data.received == true)
        || (changed.hasAny(['status']) && request.resource.data.get('status', 'Needed') == 'Received');
      return !closes
        || (request.resource.data.get('rcvQty', 0) is number
            && request.resource.data.get('rcvQty', 0) >= request.resource.data.qty);
    }

    /**
     * The displayed Manager and the person who raised it, as one expression.
     *
     * It was two branches:
     *
     *     (staff() && ((prUntouched() && prEditKeys()) || prDelivery()))
     *     || (prCreator() && ((prUntouched() && (prEditKeys() || prRemoveKeys()))
     *                         || prDelivery()))
     *
     * which is the same as the one below. When the caller raised it, the
     * Manager branch adds nothing the creator branch does not already allow;
     * when they did not, `isCreator && …` is false and what is left is the
     * Manager branch exactly. So **a Manager may still not remove somebody
     * else's requirement** — the removal list is reached only through
     * `isCreator` — and everything else is unchanged. Key lists come before
     * the document reads because they are the cheaper test.
     */
    function prRaiserOrManager(changed, isCreator) {
      return (isCreator || staff())
        && (((prEditKeys(changed) || (isCreator && prRemoveKeys(changed))) && prUntouched())
            || prDelivery(changed));
    }

    match /purchase/{id} {
      allow read: if member();
      // Everyone, Workers included, may add a requirement.
      allow create: if member()
                    && request.resource.data.id == id
                    && request.resource.data.byUid == mine()
                    && request.resource.data.qty is number && request.resource.data.qty > 0
                    && request.resource.data.status == 'Needed'
                    && (!request.resource.data.keys().hasAny(['received']) || request.resource.data.received == false)
                    && (!request.resource.data.keys().hasAny(['del']) || request.resource.data.del == false)
                    && request.resource.data.urgency in ['critical','urgent','normal']
                    && request.resource.data.updated is number
                    // A new requirement names nobody else either (Q1b).
                    && prNewUidIsCaller('upUid')
                    && prNewUidIsCaller('rcvUid')
                    && prNewUidIsCaller('cancelledUid');

      // `!worker()` is gone from the front of this rule and replaced by
      // branch structure: the limited role may now change the requirement it
      // raised itself, and `staff` may no longer change one a delivery has
      // reached. Everything common to every branch stays at the top.
      //
      // Who may do what is unchanged since N4.3:
      //
      // - **An Owner or Administrator** — anything the three rules for
      //   everyone allow (below), including the privileged correction of a
      //   received requirement and the rescue of a row the PWA stored badly.
      // - **The displayed Manager** — anybody's requirement while nothing has
      //   arrived, or a delivery against anybody's. A reopen matches neither:
      //   it removes rcvQty, and no branch here lets a received total fall.
      // - **The person who raised it**, whatever their role — the same, plus
      //   taking their own untouched requirement off the list. This is what
      //   lets a Manager withdraw their own requirement, which the Manager
      //   rights alone do not, and lets a Staff account finish one.
      //
      // N5.10b changed the shape, for the 1,000-expression limit: the checks
      // on the request come first, `member()` after them, and the diff and
      // `admin()` are each taken once and handed to `prPermitted`. It also
      // added three rules for everyone, an Owner or Administrator included:
      // `received` is a boolean when set, `status` moves only by closing,
      // cancel or reopen, and closing short needs the write-off.
      allow update: if request.resource.data.id == id
                    && request.resource.data.qty is number && request.resource.data.qty > 0
                    && request.resource.data.updated is number
                    && revOk()
                    && prIdentityPinned()
                    && member()
                    && prPermitted(touched(), admin());

      // Never a hard delete: a removed document reappears from a PWA device.
      allow delete: if false;
    }

    // --- parties and quotations ----------------------------------------

    match /customers/{id} {
      allow read: if member() && !worker();
      allow create: if member() && !worker()
                    && request.resource.data.id == id
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0;
      allow update: if request.resource.data.id == id && (
                      admin()
                      || (staff()
                          && request.resource.data.name == resource.data.name
                          && resource.data.get('archived', false) != true
                          && request.resource.data.get('archived', false) != true)
                    );
      allow delete: if admin();
    }

    // --- a finalised quotation, edited and cancelled (N5.10) ---------------

    /** The person who issued it. A quotation with no author belongs to nobody. */
    function qnCreator() {
      return resource.data.get('byUid', '') != '' && resource.data.byUid == mine();
    }

    /**
     * V8C4's cancel — its three keys, exactly as its `updateDoc` sends them,
     * and **never twice**: a second cancel would overwrite who cancelled it
     * and when, which rewrites history. V8C4 never sends one (its button shows
     * only when `admin && s !== "Cancelled"`), so this refuses nothing the
     * PWA does. V8C4 writes `cancelledBy = currentUserName()`, a **name**, and
     * `cancelledAt = Date.now()`, a **number** (the advisor's reading, Q4).
     */
    function qnCancel() {
      return touched().hasOnly(['status','cancelledBy','cancelledAt'])
        && resource.data.get('status', '') != 'Cancelled'
        && request.resource.data.status == 'Cancelled'
        && request.resource.data.cancelledBy is string
        && request.resource.data.cancelledAt is number
        && request.resource.data.no == resource.data.no
        && request.resource.data.total == resource.data.total
        && (admin() || (member() && !worker() && qnCreator()));
    }

    /**
     * Everything an edit may change — the Owner's list (Q3), and nothing
     * else. Every other key — `id`, `no`, `at`, `by`, `byUid`, `serverAt`,
     * `snap`, `status`, `cancelledBy`, `cancelledAt`, anything unknown — is
     * untouched, **present or absent**, and a `set` cannot remove one.
     */
    function qnEditKeys(changed) {
      return changed.hasOnly(['lines','party','partyId','tier','tierName','gst',
        'gstPct','subtotal','total','install','disc','discBase',
        'lastEditedBy','lastEditedByUid','lastEditedAt','rev']);
    }

    /**
     * The stamp and the revision — **what a finalise never writes**, and so
     * two of the three things that keep a finalise retry refused (the key
     * list is the third). `hasAll` because an update is checked against the
     * merged document: after one edit the stored stamp already names its
     * author, and without it that person's next update would pass carrying
     * the old time. `rev` must be the stored one plus one, so a save from a
     * stale opening is refused by the rule itself, not only by the app.
     */
    function qnEditStamped(changed) {
      return changed.hasAll(['rev', 'lastEditedAt'])
        && request.resource.data.get('lastEditedByUid', '') == mine()
        && request.resource.data.get('lastEditedBy', null) is string
        && request.resource.data.get('lastEditedAt', null) is number
        && request.resource.data.get('rev', -1) == resource.data.get('rev', 0) + 1;
    }

    /**
     * Whether an edit puts the discount **up** — the Owner's rule for the cap
     * on an edit (2026-09-28): the cap stops an edit only then. Compared with
     * the **stored** document, never with a figure the client supplies.
     *
     * Up means: a discount added where there was none; the amount rising by
     * more than a rupee; or the rate rising — the new amount exceeding the old
     * rate applied to the new base by more than a rupee (9a's margin),
     * cross-multiplied so there is no division. Anything unreadable before
     * counts as up: it fails closed.
     */
    function qnDiscountRaised() {
      let before = resource.data.get('disc', {}).get('amt', 0);
      let baseBefore = resource.data.get('discBase', 0);
      let after = discountAmount();
      let baseAfter = request.resource.data.get('discBase', 0);
      return after > 0 && (
        !(before is number) || before <= 0
        || after > before + 1
        || !(baseBefore is number)
        || after * baseBefore > before * baseAfter + baseBefore
      );
    }

    /**
     * The whole edit branch, **cheapest checks first**. The rules engine
     * stops at 1,000 evaluated expressions per request, and a first draft
     * that asked `admin()` three times and diffed the document twice reached
     * it on every discount raised within the cap — a write that must pass was
     * refused, and the refusal tests beside it passed for that reason
     * instead of theirs. So the diff is taken once, the role once, and every
     * key and stamp check runs before any role or document lookup.
     */
    function qnEdit() {
      let changed = touched();
      return qnEditKeys(changed)
        && qnEditStamped(changed)
        && resource.data.get('status', '') != 'Cancelled'
        && request.resource.data.lines is list
        && request.resource.data.subtotal is number
        && request.resource.data.total is number
        && discountShapeOk()
        && qnEditPermitted(admin());
    }

    /** Who may edit, and the cap — with the role asked once, by the caller. */
    function qnEditPermitted(isAdmin) {
      return (isAdmin || (member() && !worker() && qnCreator()))
        && (isAdmin || !qnDiscountRaised() || discountWithinCap());
    }

    match /quotations/{id} {
      allow read: if member() && !worker();
      allow create: if member() && !worker()
                    && request.resource.data.id == id
                    && request.resource.data.no is string
                    && request.resource.data.byUid == mine()
                    && request.resource.data.at is number
                    && request.resource.data.total is number
                    && discountOk();

      // Two update branches, told apart by the keys they touch.
      //
      // **CANCEL: the creator, and an Owner or Administrator on anyone's.**
      // The Owner's decision of 2026-09-28, which REPLACED the ruling of
      // 2026-09-25 that read "Owner and Administrator only … A Manager cannot
      // cancel, including their own" (V8C4's `if(!admin)`). V8C4's own
      // three-field payload from an admin is accepted unchanged.
      //
      // **EDIT: the creator, and an Owner or Administrator on anyone's** —
      // new behaviour; V8C4 cannot edit a finalised quotation. The same number
      // is overwritten, there is no revision copy, and `snap` is never
      // re-frozen (it is not in the list). A cancelled quotation cannot be
      // edited.
      //
      // **The second defence against a duplicate number survives the
      // widening.** Before N5.10, a retry that blindly re-wrote a quotation
      // was evaluated as an update, failed the cancel-only `hasOnly`, and took
      // the whole transaction — the counter bump with it — down. The edit
      // branch refuses that retry three ways: a finalise writes a fresh `at`,
      // which is not in the edit list; it carries no stamp; and no `rev`.
      // `quotation.test.js` pins the first with the old retry test and the
      // other two with a byte-for-byte re-write.
      //
      // **The cap on an edit applies only when the discount goes up**
      // (`qnDiscountRaised`); the shape of any discount is checked always, so
      // a claimed `discBase` stays bounded by `subtotal + disc.amt`.
      allow update: if qnCancel() || qnEdit();
      allow delete: if false;
    }

    // --- team settings -------------------------------------------------

    // The one counter the whole business queues behind. Two update branches,
    // and which one a write lands in is decided by what it touches, not by
    // who is signed in.
    match /teamSettings/numbering {
      allow read: if member() && !worker();

      // Seeding is configuration, so from N5.6 it follows the Owner like the
      // rest of it — and from N5.6c it is bounded exactly as the configuration
      // branch is. This is the branch **N8's production migration will use**,
      // on an unseeded project, so it must not be the weaker of the two.
      allow create: if owner()
                    && request.resource.data.next is number && request.resource.data.next >= 1
                    && request.resource.data.prefix is string
                    && request.resource.data.prefix.matches('^[A-Za-z0-9][A-Za-z0-9/-]{0,15}$')
                    && request.resource.data.fy is string
                    && request.resource.data.fy.matches('^[0-9]{4}-[0-9]{2}$')
                    && request.resource.data.pad is number
                    && request.resource.data.pad >= 1 && request.resource.data.pad <= 6;

      allow update: if
        // --- issuing a number ---------------------------------------------
        // Unchanged, and deliberately so: every quoting role reaches this
        // branch, from either app, and the counter advances by exactly one.
        (member() && !worker()
          && touched().hasOnly(['next','lastIssued'])
          && request.resource.data.next is number
          && request.resource.data.next == resource.data.next + 1
          && request.resource.data.prefix == resource.data.prefix
          && request.resource.data.fy == resource.data.fy
          && request.resource.data.pad == resource.data.pad
          && request.resource.data.get('lastIssued', {}).get('uid', '') == mine()
          && numberingSrcOk())
        ||
        // --- configuring the counter: Owner only, from N5.6 ---------------
        //
        // Two guards, and N5.6b's ablation established which does what. The
        // earlier comment here credited the wrong one; this is what the
        // evidence says.
        //
        // 1. **`next` may only move forward inside a financial year.** This is
        //    what closes N5.1's second finding — the original re-take, where an
        //    administrator issuing from a stale read wrote `next: 10` against a
        //    stored 10 and `10 >= 10` held. Strictly greater refuses it on its
        //    own. Removing this clause alone fails
        //    `an Owner rolls the financial year, and never rewinds inside one`
        //    and `a forward correction is allowed and rewinding is not`.
        //
        //    It applies only **where `next` is being changed**. Leaving it
        //    where it is is not a move forward, and has to stay allowed —
        //    otherwise correcting a prefix or a padding would force the Owner
        //    to burn a quotation number to do it.
        //
        // 2. **Configuration never stamps `lastIssued`.** This closes the gap
        //    that the `!touched(['next'])` escape hatch in (1) opens: with the
        //    hatch present and this guard gone, a stale re-stamp that leaves
        //    `next` alone walks straight through. Removing this clause alone
        //    fails `a number that is already spent cannot be re-taken, by
        //    anybody` and `but configuration may never stamp lastIssued,
        //    whatever else it does`.
        //
        // `prefix`, `fy` and `pad` are bounded to what V8C4 accepts, so a
        // value set here cannot be silently rewritten by the PWA's own clamp
        // on its next settings save. They are on the configuration branches
        // only — never on the issue branch, because issuing a number must
        // not fail merely because a stored configuration value is stale.
        //
        // The prefix pattern admits `/`, which the live counter's `SIE/QD`
        // needs: a quotation number is `{prefix}/{fy}/{n}` and the stored
        // prefix is itself two segments, so the printed number has four. A
        // pattern without `/` would refuse every save of the real data.
        (owner()
          && request.resource.data.next is number && request.resource.data.next >= 1
          && request.resource.data.prefix is string
          && request.resource.data.prefix.matches('^[A-Za-z0-9][A-Za-z0-9/-]{0,15}$')
          && request.resource.data.fy is string
          && request.resource.data.fy.matches('^[0-9]{4}-[0-9]{2}$')
          && request.resource.data.pad is number
          && request.resource.data.pad >= 1 && request.resource.data.pad <= 6
          && !touched().hasAny(['lastIssued'])
          && (request.resource.data.fy != resource.data.fy
              || !touched().hasAny(['next'])
              || request.resource.data.next > resource.data.next));

      allow delete: if false;
    }

    // The Manager discount cap, and nothing else yet. Read by everyone who
    // can quote, because the quotation form has to show a Manager the limit
    // it is about to hold them to; written by the Owner alone.
    //
    // The document may not exist: the N5.9 quotation rule reads it through a
    // guarded `exists()` and treats a missing one as a cap of zero, so an
    // unseeded project refuses a Manager's discount rather than allowing any.
    match /teamSettings/quoting {
      allow read: if member() && !worker();
      allow create, update: if owner()
                            && request.resource.data.managerDiscountPct is number
                            && request.resource.data.managerDiscountPct >= 0
                            && request.resource.data.managerDiscountPct <= 100;
      allow delete: if false;
    }

    match /teamSettings/company {
      allow read: if member() && !worker();
      allow create, update: if admin();
      allow delete: if false;
    }

    match /teamSettings/categories {
      allow read: if member() && !worker();
      allow create, update: if admin() && request.resource.data.map is map;
      allow delete: if false;
    }

    match /teamSettings/productPins {
      allow read: if member() && !worker();
      allow create, update: if admin()
                            && request.resource.data.keys is list
                            && request.resource.data.keys.size() <= 15;
      allow delete: if false;
    }

    match /teamSettings/access {
      allow read: if admin();
      // Only the Primary Owner writes the protected slots, and the primary
      // uid is immutable once the migration has written it.
      allow create: if isPrimaryOwner() && member()
                    && request.resource.data.secondOwnerUid is string;
      allow update: if isPrimaryOwner() && member()
                    && request.resource.data.secondOwnerUid is string
                    && (!resource.data.keys().hasAny(['primaryOwnerUid'])
                        || request.resource.data.primaryOwnerUid == resource.data.primaryOwnerUid);
      allow delete: if false;
    }

    // Closed by default, both ways.
    //
    // This used to grant `member() && !worker()` read to every document in the
    // collection, and because Firestore ORs across every matching rule, a
    // narrower named rule could not take that away — `/teamSettings/access`
    // declared `allow read: if admin()` and a Manager read it anyway.
    //
    // Every document either app actually uses has its own named rule above:
    // numbering, quoting, company, categories, productPins, access. The
    // native app touches five of them (`access`, `categories`, `numbering`,
    // `productPins`, `quoting`, all by string literal, no dynamic ids) and
    // V8C4 touches five (`numbering`, `company`, `categories`, `productPins`,
    // `access`). So this grant is redundant for everything that exists, and a
    // document nobody has written a rule for yet should be shut, not open.
    match /teamSettings/{other} {
      allow read, write: if false;
    }

    match /teamAudit/{id} {
      allow read: if admin();
      allow create: if admin()
                    && request.resource.data.id == id
                    && request.resource.data.byUid == mine()
                    && request.resource.data.at is number;
      allow update, delete: if false;
    }

    // --- cutover only ---------------------------------------------------
    //
    // At the cutover (migration phase M5) every write gets an additional
    // `schemaVersion == 2` requirement. V8C4 writes carry no schemaVersion,
    // so deploying that turns the PWA read-only without changing PWA code.
    // It is deliberately NOT part of these rules: enable it only in the
    // cutover window, and roll back by redeploying the V8C4 rules.
    //
    //   function v2() { return request.resource.data.schemaVersion == 2; }
    //   … && v2()   on every create/update below /products, /stock,
    //                /stockMoves, /purchase, /customers and /quotations.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
